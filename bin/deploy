#!/bin/sh
# Deploy wrapper: kept as the familiar name, implemented by bin/bootstrap.
#
# DECISION (infra): there is exactly one install implementation. `deploy` and
# `bootstrap` were on their way to duplicating the port preflight, the .env
# handling and the secret generation, which is how two scripts end up
# disagreeing about the port. This one delegates.
#
#   ./bin/deploy                 same as ./bin/bootstrap
#   ./bin/deploy --check         preflight only
#   ./bin/deploy --port 9123     a different port
#   ./bin/deploy --logs          tail the application
#   ./bin/deploy --down          stop the stack, keep ./data
#   ./bin/deploy --restart       recreate the app container

set -eu

cd "$(dirname "$0")/.."

ACTION=up
PASSTHROUGH=""

while [ $# -gt 0 ]; do
    case "$1" in
        --logs) ACTION=logs; shift ;;
        --down) ACTION=down; shift ;;
        --restart) ACTION=restart; shift ;;
        -h|--help)
            sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *)
            # --port/--check belong to bootstrap; forward them unchanged.
            PASSTHROUGH="$PASSTHROUGH $1"
            shift ;;
    esac
done

if docker compose version >/dev/null 2>&1; then
    COMPOSE="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE="docker-compose"
else
    echo "error: neither 'docker compose' nor 'docker-compose' is installed" >&2
    exit 1
fi

case "$ACTION" in
    logs)    exec $COMPOSE logs -f --tail=200 app ;;
    down)    echo "stopping the stack; ./data is untouched"; exec $COMPOSE down ;;
    restart)
        # Recreate only the app container: the database and ./data stay put.
        exec $COMPOSE up -d --no-deps app
        ;;
    up)
        # shellcheck disable=SC2086
        exec ./bin/bootstrap $PASSTHROUGH
        ;;
esac
