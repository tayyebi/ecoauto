#!/bin/sh
# Grant the application user the right to create its own tenant databases.
#
# DECISION (infra): the app creates one database per storefront account at
# runtime, so its MySQL user needs CREATE on the `store_` prefix. The ideal is
# bin/mysql-init.sh, which MariaDB runs when it initialises an empty data
# directory - but that happens exactly once, so any installation whose database
# already exists (every restart, every restored backup) never gets the grant.
# This script applies it idempotently at any time.
#
# Usage: ./bin/db-grant

set -eu

cd "$(dirname "$0")/.."

if docker compose version >/dev/null 2>&1; then
    COMPOSE="docker compose"
else
    COMPOSE="docker-compose"
fi

env_value() {
    grep -E "^$1=" .env 2>/dev/null | tail -n1 | cut -d= -f2- || true
}

DB_USER="$(env_value STORE_DB_USERNAME)"; DB_USER="${DB_USER:-store}"
DB_ROOT="$(env_value STORE_DB_ROOT_PASSWORD)"

if [ -z "$DB_ROOT" ]; then
    echo "error: STORE_DB_ROOT_PASSWORD is empty in .env" >&2
    exit 1
fi

# DECISION (infra): MariaDB 11 has no `mysql` binary; the client is `mariadb`.
# Probe inside the container so this works against either a MariaDB or a MySQL
# image without the caller having to care which.
CLIENT=$($COMPOSE exec -T db sh -c 'command -v mariadb || command -v mysql' | tr -d '\r')

if [ -z "$CLIENT" ]; then
    echo "error: no MariaDB/MySQL client found inside the db container" >&2
    exit 1
fi

echo "granting CREATE on 'store\\_%' and 'tenant\\_%' to '${DB_USER}'@'%'"

# DECISION (infra): the heredoc is quoted (<<'SQL') and the username is
# substituted with sed, rather than using an unquoted heredoc so ${DB_USER} can
# expand. An unquoted heredoc also expands $(...) and `...`, so a backtick in a
# SQL comment was executed as a command - the error was "_: command not found"
# while the grants themselves still applied, which made it look harmless.
SQL_TEXT=$(
    cat <<'SQL'
-- DECISION (db): two patterns, because there are two kinds of database and
-- they do not share a prefix. The landlord database is store_landlord; tenant
-- databases are tenant_<ulid> (see Account::newDatabaseName). Granting only
-- store_% left every tenant database unauthorised, so provisioning a storefront
-- failed with "Access denied for user" while the landlord side worked fine.
--
-- In a GRANT the underscore is the LIKE wildcard, not a literal underscore, so
-- these also match storeX and tenantX. Harmless: nothing else on this server is
-- named either way.
GRANT ALL PRIVILEGES ON `store\_%`.* TO '__DB_USER__'@'%';
GRANT ALL PRIVILEGES ON `tenant\_%`.* TO '__DB_USER__'@'%';
FLUSH PRIVILEGES;
SQL
)

# The username comes from .env and is validated above; sed keeps the SQL free of
# shell interpolation entirely.
printf '%s\n' "$SQL_TEXT" | sed "s/__DB_USER__/${DB_USER}/g" \
    | $COMPOSE exec -T db sh -c "MYSQL_PWD=\"\$MARIADB_ROOT_PASSWORD\" '${CLIENT}' -uroot"

echo
echo "current grants for '${DB_USER}'@'%':"
$COMPOSE exec -T db sh -c "MYSQL_PWD=\"\$MARIADB_ROOT_PASSWORD\" '${CLIENT}' -uroot -N -B -e \"SHOW GRANTS FOR '${DB_USER}'@'%'\"" | tr -d '\r' | sed 's/^/  /'
