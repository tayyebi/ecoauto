STORE_NAME=store

APP_ENV=production
APP_KEY=
APP_DEBUG=false
# DECISION (infra): the deploy target publishes exactly one port and expects
# 9020 on it. Keep APP_URL and STORE_PORT in agreement.
APP_URL=http://localhost:9020

# The single bound port. The server binds 0.0.0.0 so the host proxy can reach
# it; do not add a second port anywhere.
STORE_HOST=0.0.0.0
STORE_PORT=9020

# Everything that changes lives here and is git-ignored.
STORE_DATA_PATH=

# The MySQL server keeps its data files under ./data/mysql. Point these at it,
# or at any MySQL/MariaDB server you prefer.
STORE_DB_HOST=127.0.0.1
STORE_DB_PORT=3306
STORE_DB_USERNAME=store
STORE_DB_PASSWORD=
STORE_DB_LANDLORD=store_landlord

# The account served when a hostname is not registered. Leave empty in
# production so an unknown host gets a 404 instead of another tenant's store.
STORE_DEFAULT_ACCOUNT=
STORE_PLATFORM_ACCOUNT_ID=

# Hosts that are treated as the control plane rather than a storefront.
STORE_CONTROL_PLANE_HOSTS=localhost,127.0.0.1

STORE_CURRENCY=IRR
STORE_PAYMENT_DRIVER=placeholder

STORE_PER_PAGE_PRODUCTS=20
STORE_PER_PAGE_BLOG=10
STORE_PER_PAGE_VENDORS=12
STORE_PER_PAGE_ADMIN=25

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

QUEUE_CONNECTION=sync

MAIL_MAILER=log
