# Copy to .env and fill the blanks. `./bin/deploy` does this for you.
STORE_NAME=store

APP_ENV=production
APP_KEY=
APP_DEBUG=false

# DECISION (infra): one port, 9020, used for the app and the published host
# port alike. APP_URL must agree with it or generated links and the payment
# callback will point at the wrong place. Put your real domain here in
# production; the app itself does not care what the hostname is.
APP_URL=http://localhost:9020

# Bind every interface inside the container; the published port needs it.
STORE_HOST=0.0.0.0
STORE_PORT=9020

# Everything that changes lives here and is git-ignored.
STORE_DATA_PATH=

# ---------------------------------------------------------------- database
# Inside docker-compose the app reaches MariaDB as the service name `db`.
# STORE_DB_PASSWORD and STORE_DB_ROOT_PASSWORD are required - compose refuses
# to start without them.
STORE_DB_HOST=db
STORE_DB_PORT=3306
STORE_DB_USERNAME=store
STORE_DB_PASSWORD=
STORE_DB_ROOT_PASSWORD=
STORE_DB_LANDLORD=store_landlord

# How long the entrypoint waits for MariaDB on every boot before giving up.
STORE_DB_WAIT_ATTEMPTS=30
STORE_DB_WAIT_SECONDS=2

# ------------------------------------------------------------ first operator
# The administrator created by the first seed. Change the password on first
# login; the default is a fixed string on purpose so a fresh install is usable.
STORE_ADMIN_EMAIL=tayyebimohammadreza@gmail.com
STORE_ADMIN_PASSWORD=password

# ---------------------------------------------------------------- tenancy
# The account served when a hostname is not registered. Leave empty in
# production so an unknown host gets a 404 instead of another tenant's store.
STORE_DEFAULT_ACCOUNT=
STORE_PLATFORM_ACCOUNT_ID=

# Hosts that are treated as the control plane rather than a storefront.
STORE_CONTROL_PLANE_HOSTS=localhost,127.0.0.1

# --------------------------------------------------------------- storefront
STORE_CURRENCY=IRR
STORE_PAYMENT_DRIVER=placeholder

STORE_PER_PAGE_PRODUCTS=20
STORE_PER_PAGE_BLOG=10
STORE_PER_PAGE_VENDORS=12
STORE_PER_PAGE_ADMIN=25

# ------------------------------------------------------------------ storage
# All of these default to paths under ./data, which is the only directory the
# container mounts read-write besides storage/.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# STORE_SESSION_PATH=/app/data/sessions

CACHE_STORE=file
# CACHE_FILE_PATH=/app/data/cache

LOG_CHANNEL=stack
LOG_LEVEL=warning
# STORE_LOG_PATH=/app/data/logs/laravel.log

QUEUE_CONNECTION=sync

MAIL_MAILER=log
